# Pakistan National Food Business & POS Sales Intelligence Platform Configuration

# Environment
APP_ENV=development
PORT=5000
DEBUG=True
SECRET_KEY=pakistan_food_intel_secret_key_2026

# Database Configuration
# Default uses embedded SQLite database for zero-configuration local runs
DB_TYPE=sqlite
DB_PATH=database/food_intel.db

# For PostgreSQL with PostGIS in production:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pakistan_food_pos
# DB_USER=postgres
# DB_PASSWORD=your_password

# External API Connectors (Optional - built-in fallback modes included)
GOOGLE_PLACES_API_KEY=
OVERPASS_API_MIRROR=https://overpass-api.de/api/interpreter
NOMINATIM_USER_AGENT=PakistanFoodIntelPlatform/1.0 (info@pakistanfoodpos.org)

# Lead Notification Webhooks (Optional)
SLACK_WEBHOOK_URL=
WHATSAPP_BUSINESS_API_TOKEN=
